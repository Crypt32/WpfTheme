<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net472;net10.0-windows</TargetFrameworks>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <RootNamespace>SysadminsLV.WPF</RootNamespace>
    <Title>SysadminsLV.Wpf</Title>
    <Version>2.0.0-preview.3</Version>
    <Authors>Vadims Podāns</Authors>
    <Copyright>Copyright © Sysadmins LV  2018 - 2026</Copyright>
    <Company>Sysadmins LV</Company>
    <Product>WpfTheme</Product>
    <Description>Windows Presentation Framework Helper Library</Description>
    <PackageId>SysadminsLV.WPF</PackageId>
    <AssemblyName>SysadminsLV.WPF</AssemblyName>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TF_BUILD)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net472'">
    <Reference Include="PresentationFramework.Aero" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Themes\Images\**" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Properties\" />
  </ItemGroup>
</Project>