<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../Border.xaml"/>
        <ResourceDictionary Source="../../Brushes/DefaultColorTheme.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!--
       Chrome shared by the panel controls: a frame around two stacked areas, a header band and a content area.
       The band carries a light top and left edge and the content area carries the dark edge that faces the band,
       so the three together read as a relief, the way a SharePoint 2007 panel header does.
       The band paints both of those light edges itself: its BorderThickness lights the top and the left and leaves
       the remaining two sides to the control's frame. One Border can do that only because the two edges share a
       brush; if they ever have to differ again they go back to being separate elements, because a Border has a
       single BorderBrush and cannot paint one side in a colour of its own.
       Keeping the dark edge on the content area rather than under the band also keeps a collapsed Expander, which has
       no content area, from showing the frame's line and a separator line directly on top of each other.
       Layout rounding keeps the hairlines on whole device pixels; without it they blur to gray above 100% DPI.
    -->
    <Thickness x:Key="Panel.Header.Padding">5,3</Thickness>

    <Style x:Key="Panel.HeaderBandBorder" TargetType="Border" BasedOn="{StaticResource {x:Type Border}}">
        <Setter Property="Background" Value="{StaticResource Panel.Header.BgBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Panel.Header.Highlight.BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1,1,0,0"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
    </Style>

    <!--
       The content area. Background is deliberately not set here: every template template-binds it to the control's own
       Background, so that setting Background on a panel means "fill the content area" and nothing else. The border is
       the single edge facing the header band, which the ExpandDirection triggers of the Expander move to another side.
       Padding is not defaulted either, by the same division: the theme pads the header band because the band is chrome
       it draws itself and nobody else can inset it, while the content area is the consumer's canvas. A panel cannot
       know whether it has been handed a ListView, DataGrid or TreeView, which has to bleed to the frame, or a stack of
       text boxes, which needs air, so an inset there would be a guess that every full-bleed host has to take back out.
       Content that wants air asks for it with a Margin, or by setting Padding on the panel; content that wants none
       gets none. The templates still template-bind Padding, so setting it on a panel works as it always did.
    -->
    <Style x:Key="Panel.ContentAreaBorder" TargetType="Border" BasedOn="{StaticResource {x:Type Border}}">
        <Setter Property="BorderBrush" Value="{StaticResource Panel.Header.BorderBrush}"/>
        <Setter Property="BorderThickness" Value="0,1,0,0"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
    </Style>
</ResourceDictionary>
