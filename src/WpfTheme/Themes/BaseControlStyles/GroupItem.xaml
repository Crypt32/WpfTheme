<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../Brushes/DefaultColorTheme.xaml"/>
        <ResourceDictionary Source="Panels/PanelChrome.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!--
       Default group header content: the group's Name. A view whose header text lives elsewhere (Name.DisplayName, ...)
       supplies GroupStyle.HeaderTemplate with a bare TextBlock; the chrome below still applies to it, because the
       band and the inherited font weight/foreground belong to the GroupItem, not to the template.
    -->
    <DataTemplate DataType="{x:Type CollectionViewGroup}">
        <TextBlock Text="{Binding Name}"/>
    </DataTemplate>

    <!--
       The group header band mirrors the HeaderedContentControl header: the same fill, padding, bold text, light top
       edge inside a darker frame edge above and below. It has no left or right border, because inside a ComboBox popup, ListView or
       DataGrid the host control's own border already closes those sides.
    -->
    <Style x:Key="{x:Type GroupItem}"
           TargetType="{x:Type GroupItem}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type GroupItem}">
                    <StackPanel>
                        <Border BorderThickness="0,1"
                                BorderBrush="{StaticResource Panel.Header.BorderBrush}"
                                SnapsToDevicePixels="True">
                            <Border Style="{StaticResource Panel.HeaderBandBorder}"
                                    BorderThickness="0,1,0,0"
                                    Background="{StaticResource Panel.Header.Hover.BgBrush}">
                                <ContentPresenter Margin="{StaticResource Panel.Header.Padding}"
                                                  TextElement.FontWeight="Bold"
                                                  TextElement.Foreground="{StaticResource Panel.Header.FgBrush}"/>
                            </Border>
                        </Border>
                        <ItemsPresenter Margin="5,0,0,0"/>
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
