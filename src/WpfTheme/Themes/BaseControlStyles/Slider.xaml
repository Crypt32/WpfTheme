                              Fill="{StaticResource Slider.Thumb.Horizontal.Inverted.BgGradient}"
                              Data="{StaticResource SliderPointedThumbOuterBorderGeometry}"/>
                        <Path x:Name="InnerBorder"
                              Stroke="{StaticResource Slider.Thumb.Highlight.BorderBrush}"
                              StrokeThickness="1"
                              Data="{StaticResource SliderPointedThumbMiddleBorderGeometry}"/>
                        <Path x:Name="OuterBorder"
                              Stroke="{StaticResource Slider.Thumb.BorderBrush}"
