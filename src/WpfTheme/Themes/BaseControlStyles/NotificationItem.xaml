<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:SysadminsLV.WPF.Controls">
    <Geometry x:Key="NotificationItem.DismissGlyph">F1M0,0L2,0 5,3 8,0 10,0 6,4 10,8 8,8 5,5 2,8 0,8 4,4 0,0z</Geometry>

    <Style x:Key="NotificationItemDismissButtonStyle" TargetType="{x:Type Button}">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="bd"
                            Background="Transparent"
                            CornerRadius="2">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#26000000"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#40000000"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type c:NotificationItem}">
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Padding" Value="4"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Top"/>
        <Setter Property="Background" Value="#FFCCE5FF"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type c:NotificationItem}">
                    <Grid>
                    <Border x:Name="BdTopLeft" BorderThickness="1,1,0,0" Background="Transparent"/>
                    <Border x:Name="BdBottomRight" BorderThickness="0,0,1,1" Background="Transparent"/>
                    <Border Background="{TemplateBinding Background}"
                            BorderThickness="1"
                            Padding="{TemplateBinding Padding}">
                        <DockPanel>
                            <Image x:Name="Icon"
                                   DockPanel.Dock="Left"
                                   Width="16"
                                   Height="16"
                                   Margin="0,0,4,0"
                                   Source="{TemplateBinding Icon}"
                                   VerticalAlignment="Top"/>
                            <Button x:Name="DismissButton"
                                    DockPanel.Dock="Right"
                                    Width="16"
                                    Height="16"
                                    Margin="4,0,0,0"
                                    VerticalAlignment="Top"
                                    Style="{StaticResource NotificationItemDismissButtonStyle}"
                                    Command="{x:Static c:NotificationItem.DismissCommand}">
                                <Path x:Name="DismissGlyph"
                                      Data="{StaticResource NotificationItem.DismissGlyph}"
                                      Fill="#FF5F6FA4"
                                      Stretch="None"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                            </Button>
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </DockPanel>
                    </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger SourceName="Icon" Property="Source" Value="{x:Null}">
                            <Setter TargetName="Icon" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="Kind" Value="Info">
                            <Setter TargetName="BdTopLeft" Property="BorderBrush" Value="#B0CCE5FF"/>
                            <Setter TargetName="BdBottomRight" Property="BorderBrush" Value="#C1DBF7"/>
                            <Setter TargetName="DismissGlyph" Property="Fill" Value="#004085"/>
                        </Trigger>
                        <Trigger Property="Kind" Value="Success">
                            <Setter TargetName="BdTopLeft" Property="BorderBrush" Value="#80D4EDDA"/>
                            <Setter TargetName="BdBottomRight" Property="BorderBrush" Value="#FFC6E5CD"/>
                            <Setter TargetName="DismissGlyph" Property="Fill" Value="#155724"/>
                        </Trigger>
                        <Trigger Property="Kind" Value="Warning">
                            <Setter TargetName="BdTopLeft" Property="BorderBrush" Value="#80FEFEDF"/>
                            <Setter TargetName="BdBottomRight" Property="BorderBrush" Value="#FFF3F0AA"/>
                            <Setter TargetName="DismissGlyph" Property="Fill" Value="#856404"/>
                        </Trigger>
                        <Trigger Property="Kind" Value="Danger">
                            <Setter TargetName="BdTopLeft" Property="BorderBrush" Value="#B0FFCDD2"/>
                            <Setter TargetName="BdBottomRight" Property="BorderBrush" Value="#FFF2C0C5"/>
                            <Setter TargetName="DismissGlyph" Property="Fill" Value="#721c24"/>
                        </Trigger>
                        <Trigger Property="IsDismissable" Value="False">
                            <Setter TargetName="DismissButton" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Kind" Value="Success">
                <Setter Property="Background" Value="#FFD4EDDA"/>
            </Trigger>
            <Trigger Property="Kind" Value="Warning">
                <Setter Property="Background" Value="#FFFDFAB1"/>
            </Trigger>
            <Trigger Property="Kind" Value="Danger">
                <Setter Property="Background" Value="#FFFFCDD2"/>
            </Trigger>
            <Trigger Property="IsDismissed" Value="True">
                <Setter Property="Visibility" Value="Collapsed"/>
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
