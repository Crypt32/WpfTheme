<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Border.xaml"/>
        <ResourceDictionary Source="../Brushes/DefaultColorTheme.xaml"/>
        <ResourceDictionary Source="Panels/PanelChrome.xaml"/>
    </ResourceDictionary.MergedDictionaries>


    <Style x:Key="ExpanderHeaderFocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border>
                        <Rectangle Margin="0"
                                   StrokeDashArray="1 2"
                                   Stroke="{StaticResource Expander.Focus.BorderBrush}"
                                   StrokeThickness="1"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="ExpanderPath" TargetType="Path">
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Data" Value="M 1,1.5 L 4.5,5 L 8,1.5"/>
        <Setter Property="Stroke" Value="{StaticResource Expander.Arrow.FgBrush}"/>
        <Setter Property="SnapsToDevicePixels" Value="False"/>
        <Setter Property="StrokeThickness" Value="2"/>
    </Style>
    <Style x:Key="ExpanderEllipse" TargetType="Ellipse">
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Height" Value="19"/>
        <Setter Property="Width" Value="19"/>
        <Setter Property="Stroke" Value="{StaticResource Expander.Circle.BorderBrush}"/>
        <Setter Property="Fill" Value="{StaticResource Expander.Circle.BgBrush}"/>
    </Style>
    <Style x:Key="ExpanderContentPresenter" TargetType="ContentPresenter">
        <Setter Property="RecognizesAccessKey" Value="True"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <!-- Only the gap to the toggle circle: the band's own padding comes from Panel.Header.Padding below. -->
        <Setter Property="Margin" Value="0,0,4,0"/>
    </Style>
    <ControlTemplate x:Key="ExpanderUpDownTemplate" TargetType="{x:Type ToggleButton}">
        <Border x:Name="HeaderBorder"
                Style="{StaticResource Panel.HeaderBandBorder}">
            <DockPanel Margin="{StaticResource Panel.Header.Padding}"
                       UseLayoutRounding="True">
                <Grid x:Name="ExButton" DockPanel.Dock="Right">
                    <Grid.LayoutTransform>
                        <TransformGroup>
                            <TransformGroup.Children>
                                <TransformCollection>
                                    <RotateTransform Angle="0"/>
                                </TransformCollection>
                            </TransformGroup.Children>
                        </TransformGroup>
                    </Grid.LayoutTransform>
                    <Ellipse x:Name="circle"
                             Style="{StaticResource ExpanderEllipse}"/>
                    <Path x:Name="arrow"
                          Style="{StaticResource ExpanderPath}"/>
                </Grid>
                <ContentPresenter Style="{StaticResource ExpanderContentPresenter}"/>
            </DockPanel>
        </Border>
        <ControlTemplate.Triggers>
            <DataTrigger Binding="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Expander}}, Path=ExpandDirection}" Value="Up">
                <Setter Property="LayoutTransform" TargetName="ExButton">
                    <Setter.Value>
                        <TransformGroup>
                            <RotateTransform Angle="180"/>
                        </TransformGroup>
                    </Setter.Value>
                </Setter>
            </DataTrigger>
            <DataTrigger Binding="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Expander}}, Path=ExpandDirection}" Value="Left">
                <Setter Property="LayoutTransform" TargetName="ExButton">
                    <Setter.Value>
                        <TransformGroup>
                            <RotateTransform Angle="90"/>
                        </TransformGroup>
                    </Setter.Value>
                </Setter>
            </DataTrigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Data" TargetName="arrow" Value="M 1,4.5  L 4.5,1  L 8,4.5"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Stroke" TargetName="circle" Value="{StaticResource Expander.Circle.Hover.BorderBrush}"/>
                <Setter Property="Fill" TargetName="circle" Value="{StaticResource Expander.Circle.Hover.BgBrush}"/>
                <Setter Property="Stroke" TargetName="arrow" Value="{StaticResource Expander.Arrow.Hover.FgBrush}"/>
                <Setter TargetName="HeaderBorder" Property="Background" Value="{StaticResource Panel.Header.Hover.BgBrush}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Stroke" TargetName="circle" Value="{StaticResource Expander.Circle.Pressed.BorderBrush}"/>
                <Setter Property="StrokeThickness" TargetName="circle" Value="1.5"/>
                <Setter Property="Fill" TargetName="circle" Value="{StaticResource Expander.Circle.Pressed.BgBrush}"/>
                <Setter Property="Stroke" TargetName="arrow" Value="{StaticResource Expander.Arrow.Pressed.FgBrush}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Stroke" TargetName="circle" Value="{StaticResource Expander.Circle.Disabled.BorderBrush}"/>
                <Setter Property="Fill" TargetName="circle" Value="{StaticResource Expander.Circle.Disabled.BgBrush}"/>
                <Setter Property="Stroke" TargetName="arrow" Value="{StaticResource Expander.Arrow.Disabled.FgBrush}"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
    <ControlTemplate x:Key="ExpanderLeftRightTemplate" TargetType="{x:Type ToggleButton}">
        <Border x:Name="HeaderBorder"
                Style="{StaticResource Panel.HeaderBandBorder}">
            <DockPanel x:Name="Header"
                       Margin="{StaticResource Panel.Header.Padding}"
                       UseLayoutRounding="True">
                <DockPanel.LayoutTransform>
                    <TransformGroup>
                        <TransformGroup.Children>
                            <TransformCollection>
                                <RotateTransform Angle="90"/>
                            </TransformCollection>
                        </TransformGroup.Children>
                    </TransformGroup>
                </DockPanel.LayoutTransform>
                <Grid x:Name="ExButton"
                      DockPanel.Dock="Left">
                    <Ellipse x:Name="circle"
                             Style="{StaticResource ExpanderEllipse}"/>
                    <Path x:Name="arrow"
                          Style="{StaticResource ExpanderPath}"/>
                </Grid>
                <ContentPresenter x:Name="Content" Style="{StaticResource ExpanderContentPresenter}"/>
            </DockPanel>
        </Border>
        <ControlTemplate.Triggers>
            <DataTrigger Binding="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Expander}}, Path=ExpandDirection}" Value="Right">
                <Setter Property="LayoutTransform" TargetName="Header">
                    <Setter.Value>
                        <TransformGroup>
                            <RotateTransform Angle="-90"/>
                        </TransformGroup>
                    </Setter.Value>
                </Setter>
                <Setter TargetName="ExButton" Property="DockPanel.Dock" Value="Right"/>
                <Setter TargetName="Content" Property="HorizontalAlignment" Value="Right"/>
            </DataTrigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Data" TargetName="arrow" Value="M 1,4.5  L 4.5,1  L 8,4.5"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Stroke" TargetName="circle" Value="{StaticResource Expander.Circle.Hover.BorderBrush}"/>
                <Setter Property="Fill" TargetName="circle" Value="{StaticResource Expander.Circle.Hover.BgBrush}"/>
                <Setter Property="Stroke" TargetName="arrow" Value="{StaticResource Expander.Arrow.Hover.FgBrush}"/>
                <Setter TargetName="HeaderBorder" Property="Background" Value="{StaticResource Panel.Header.Hover.BgBrush}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Stroke" TargetName="circle" Value="{StaticResource Expander.Circle.Pressed.BorderBrush}"/>
                <Setter Property="StrokeThickness" TargetName="circle" Value="1.5"/>
                <Setter Property="Fill" TargetName="circle" Value="{StaticResource Expander.Circle.Pressed.BgBrush}"/>
                <Setter Property="Stroke" TargetName="arrow" Value="{StaticResource Expander.Arrow.Pressed.FgBrush}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Stroke" TargetName="circle" Value="{StaticResource Expander.Circle.Disabled.BorderBrush}"/>
                <Setter Property="Fill" TargetName="circle" Value="{StaticResource Expander.Circle.Disabled.BgBrush}"/>
                <Setter Property="Stroke" TargetName="arrow" Value="{StaticResource Expander.Arrow.Disabled.FgBrush}"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style TargetType="{x:Type Expander}">
        <Setter Property="Foreground" Value="{StaticResource Panel.FgBrush}"/>
        <Setter Property="Background" Value="{StaticResource Panel.Surface.BgBrush}"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Stretch"/>
        <!--
           A full frame, with no trigger touching it. An Expander that knows nothing about its surroundings has to
           terminate its own edges, so the context-free default is the closed box. Where a bordered control does sit on
           the side this one expands towards, use Panel.DockedExpander below, which yields that edge to the neighbour.
        -->
        <Setter Property="BorderBrush" Value="{StaticResource Panel.BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Expander}">
                    <!-- The frame around the whole control. It paints no fill: Background belongs to the content area. -->
                    <Border x:Name="FrameBorder"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            SnapsToDevicePixels="True">
                        <DockPanel>
                            <ToggleButton x:Name="HeaderSite"
                                          DockPanel.Dock="Top"
                                          Content="{TemplateBinding Header}"
                                          ContentTemplateSelector="{TemplateBinding HeaderTemplateSelector}"
                                          FontStretch="{TemplateBinding FontStretch}"
                                          Foreground="{StaticResource Panel.Header.FgBrush}"
                                          FocusVisualStyle="{StaticResource ExpanderHeaderFocusVisual}"
                                          FontStyle="{TemplateBinding FontStyle}"
                                          FontFamily="{TemplateBinding FontFamily}"
                                          FontWeight="Bold"
                                          FontSize="{TemplateBinding FontSize}"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          MinWidth="0"
                                          MinHeight="0"
                                          Template="{StaticResource ExpanderUpDownTemplate}"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"/>
                            <!-- Padding insets the content only, and defaults to nothing: see Panel.ContentAreaBorder. -->
                            <Border x:Name="ExpandArea"
                                    DockPanel.Dock="Bottom"
                                    Background="{TemplateBinding Background}"
                                    Padding="{TemplateBinding Padding}"
                                    Style="{StaticResource Panel.ContentAreaBorder}"
                                    Visibility="Collapsed">
                                <ContentPresenter x:Name="ExpandSite"
                                                  Focusable="False"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                            </Border>
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="True">
                            <Setter Property="Visibility" TargetName="ExpandArea" Value="Visible"/>
                        </Trigger>
                        <!-- Each direction also moves the content area's single border to the side facing the header. -->
                        <Trigger Property="ExpandDirection" Value="Right">
                            <Setter Property="DockPanel.Dock" TargetName="ExpandArea" Value="Right"/>
                            <Setter Property="BorderThickness" TargetName="ExpandArea" Value="1,0,0,0"/>
                            <Setter Property="DockPanel.Dock" TargetName="HeaderSite" Value="Left"/>
                            <Setter Property="Template" TargetName="HeaderSite" Value="{StaticResource ExpanderLeftRightTemplate}"/>
                        </Trigger>
                        <Trigger Property="ExpandDirection" Value="Up">
                            <Setter Property="DockPanel.Dock" TargetName="ExpandArea" Value="Top"/>
                            <Setter Property="BorderThickness" TargetName="ExpandArea" Value="0,0,0,1"/>
                            <Setter Property="DockPanel.Dock" TargetName="HeaderSite" Value="Bottom"/>
                            <Setter Property="Template" TargetName="HeaderSite" Value="{StaticResource ExpanderUpDownTemplate}"/>
                        </Trigger>
                        <Trigger Property="ExpandDirection" Value="Left">
                            <Setter Property="DockPanel.Dock" TargetName="ExpandArea" Value="Left"/>
                            <Setter Property="BorderThickness" TargetName="ExpandArea" Value="0,0,1,0"/>
                            <Setter Property="DockPanel.Dock" TargetName="HeaderSite" Value="Right"/>
                            <Setter Property="Template" TargetName="HeaderSite" Value="{StaticResource ExpanderLeftRightTemplate}"/>
                        </Trigger>
                        <!--
                           A collapsed Expander is nothing but its header, so the frame hugs the header instead of
                           outlining the space a stretching parent hands the control. A star-sized Grid row or a
                           DockPanel gives it the whole slot, and with the content area collapsed there is nothing to
                           paint in between, so without this the far frame edge ends up a long way from the header it
                           belongs to, with an empty outlined box between the two.
                           Only the axis the control expands along is released; the other one keeps stretching, so the
                           header still spans the width, or the height, that it was given.
                        -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsExpanded" Value="False"/>
                                <Condition Property="ExpandDirection" Value="Down"/>
                            </MultiTrigger.Conditions>
                            <Setter Property="VerticalAlignment" TargetName="FrameBorder" Value="Top"/>
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsExpanded" Value="False"/>
                                <Condition Property="ExpandDirection" Value="Up"/>
                            </MultiTrigger.Conditions>
                            <Setter Property="VerticalAlignment" TargetName="FrameBorder" Value="Bottom"/>
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsExpanded" Value="False"/>
                                <Condition Property="ExpandDirection" Value="Right"/>
                            </MultiTrigger.Conditions>
                            <Setter Property="HorizontalAlignment" TargetName="FrameBorder" Value="Left"/>
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsExpanded" Value="False"/>
                                <Condition Property="ExpandDirection" Value="Left"/>
                            </MultiTrigger.Conditions>
                            <Setter Property="HorizontalAlignment" TargetName="FrameBorder" Value="Right"/>
                        </MultiTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
       An Expander that is docked against another control, or stacked into an accordion. It drops the frame edge on the
       side it expands towards, because an Expander grows into its expansion direction and that side is therefore the
       one facing the neighbour. That neighbour is usually a TextBox, ListView, DataGrid or TreeView, whose border
       brush changes with hover, focus and validation state. Whoever owns the line between the two has to be able to
       paint every state that line can be in, and an Expander cannot, so it yields the edge rather than making the
       neighbour drop a border it needs: a validation error that loses an edge to a panel frame is a lost error signal,
       not a cosmetic flaw.
       The gap exists while the control is collapsed, which is how it stands most of the time. Expanding closes the
       frame again, so the header and the expanded content sit in one box: the double line that costs against the
       neighbour is worth paying for a panel the user opened deliberately and will close again, and the toggle is
       already resizing the control by the whole height of its content, so one pixel changes nothing.
       The gap lives here rather than on the implicit style so that nothing has to be neutralised to get a plain frame:
       a style trigger outranks a style setter even across BasedOn, so an opted-out style could not simply set the
       thickness back.
    -->
    <Style x:Key="Panel.DockedExpander" TargetType="{x:Type Expander}" BasedOn="{StaticResource {x:Type Expander}}">
        <Setter Property="BorderThickness" Value="1,1,1,0"/>
        <Style.Triggers>
            <!-- Thickness is Left,Top,Right,Bottom; each direction drops the side the content grows towards. -->
            <Trigger Property="ExpandDirection" Value="Up">
                <Setter Property="BorderThickness" Value="1,0,1,1"/>
            </Trigger>
            <Trigger Property="ExpandDirection" Value="Left">
                <Setter Property="BorderThickness" Value="0,1,1,1"/>
            </Trigger>
            <Trigger Property="ExpandDirection" Value="Right">
                <Setter Property="BorderThickness" Value="1,1,0,1"/>
            </Trigger>
            <!--
               Last, so that it wins over the direction triggers above: among style triggers that set the same
               property, the one declared last applies. Expanding therefore closes the frame whichever way it opens.
            -->
            <Trigger Property="IsExpanded" Value="True">
                <Setter Property="BorderThickness" Value="1"/>
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
