<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../Brushes/DefaultColorTheme.xaml"/>
        <ResourceDictionary Source="../NamedStyles/CheckRadioFocusVisual.xaml"/>
    </ResourceDictionary.MergedDictionaries>
    
    <Style x:Key="{x:Type RadioButton}" TargetType="{x:Type RadioButton}">
        <Setter Property="Foreground" Value="{StaticResource CheckBox.FgBrush}"/>
        <Setter Property="Background" Value="{StaticResource CheckBox.BgBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource CheckBox.BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RadioButton}">
                    <BulletDecorator Background="Transparent">
                        <BulletDecorator.Bullet>
                            <Grid Width="16" Height="16" Margin="0,1,1,1" SnapsToDevicePixels="True">
                                <Ellipse x:Name="box"
                                         Fill="{TemplateBinding Background}"
                                         Stroke="{TemplateBinding BorderBrush}"
                                         StrokeThickness="1"/>
                                <Ellipse x:Name="inner"
                                         Margin="2"
                                         Fill="{StaticResource CheckBox.Inner.BgGradient}"
                                         Stroke="{StaticResource CheckBox.Inner.BorderGradient}"
                                         StrokeThickness="1"/>
                                <Ellipse x:Name="dot"
                                         Margin="3"
                                         Fill="{StaticResource RadioButton.Dot.BgGradient}"
                                         Stroke="{TemplateBinding Foreground}"
                                         StrokeThickness="1"
                                         Visibility="Collapsed"/>
                            </Grid>
                        </BulletDecorator.Bullet>
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          RecognizesAccessKey="True"/>
                    </BulletDecorator>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HasContent" Value="true">
                            <Setter Property="FocusVisualStyle"
                                    Value="{StaticResource CheckRadioFocusVisual}"/>
                            <Setter Property="Padding" Value="4,0,0,0"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="dot" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="box" Property="Fill" Value="{StaticResource CheckBox.Hover.BgBrush}"/>
                            <Setter TargetName="box" Property="Stroke" Value="{StaticResource CheckBox.Hover.BorderBrush}"/>
                            <Setter TargetName="inner" Property="Fill" Value="{StaticResource CheckBox.Inner.Hover.BgGradient}"/>
                            <Setter TargetName="inner" Property="Stroke" Value="{StaticResource CheckBox.Inner.Hover.BorderGradient}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="box" Property="Fill" Value="{StaticResource CheckBox.Pressed.BgBrush}"/>
                            <Setter TargetName="box" Property="Stroke" Value="{StaticResource CheckBox.Pressed.BorderBrush}"/>
                            <Setter TargetName="inner" Property="Fill" Value="{StaticResource CheckBox.Inner.Pressed.BgGradient}"/>
                            <Setter TargetName="inner" Property="Stroke" Value="{StaticResource CheckBox.Inner.Pressed.BorderGradient}"/>
                            <Setter TargetName="dot" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="false">
                            <Setter Property="Foreground"
                                    Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"/>
                            <Setter TargetName="box" Property="Fill" Value="{StaticResource CheckBox.Disabled.BgBrush}"/>
                            <Setter TargetName="box" Property="Stroke" Value="{StaticResource CheckBox.Disabled.BorderBrush}"/>
                            <Setter TargetName="inner" Property="Fill" Value="{x:Null}"/>
                            <Setter TargetName="inner" Property="Stroke" Value="{StaticResource CheckBox.Inner.Disabled.BorderBrush}"/>
                            <Setter TargetName="dot" Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>