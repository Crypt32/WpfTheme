<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options">
    <!--Palette Colors-->
    <Color x:Key="Panel.BgColor">                         #FFE2EEFE</Color>
    <Color x:Key="Menu.BgColor">                          #FFBFDBFF</Color>
    <Color x:Key="Menu.Active.BorderColor">               #FFF4AD56</Color>
    <Color x:Key="Border.Color">                          #FF6592CE</Color>
    <Color x:Key="Border.LightColor">                     #FFADD1FF</Color>
    <Color x:Key="Text.FgColor">                          #FF15429F</Color>
    <Color x:Key="Control.BgColor">                       #FFF4F4F4</Color>
    <Color x:Key="Neutral.SoftColor">                     #FFD6D8D9</Color>
    <Color x:Key="Neutral.WhiteColor">                    #FFFFFFFF</Color>
    <Color x:Key="Neutral.BlackColor">                    #FF000000</Color>
    <Color x:Key="Border.DisabledColor">                  #FFAAAAAA</Color>
    <Color x:Key="Text.MutedFgColor">                     #FF4971A3</Color>
    <Color x:Key="Neutral.GrayColor">                     #FF888888</Color>
    <Color x:Key="ClosableTabControl.BgColor">            #FFEEF7FF</Color>
    <Color x:Key="ClosableTabControl.PanelBgColor">       #FFBEDAFE</Color>
    <Color x:Key="TabScrollButton.BgLightColor">          #FFFAFAD2</Color>
    <Color x:Key="TabScrollButton.BgDarkColor">           #FFFAEEB1</Color>
    <Color x:Key="TabScrollButton.Disabled.BgLightColor"> #FFEEEEEE</Color>
    <Color x:Key="TabScrollButton.Disabled.BgDarkColor">  #FF999999</Color>
    <Color x:Key="Accent.Color">                          #FF000080</Color>
    <Color x:Key="Status.Default.SolidColor">             #FF343A40</Color>
    <Color x:Key="Status.Default.DarkColor">              #FF1B1E21</Color>
    <Color x:Key="Status.Primary.SolidColor">             #FF004FA3</Color>
    <Color x:Key="Status.Primary.SoftColor">              #FFCCE5FF</Color>
    <Color x:Key="Status.Primary.DarkColor">              #FF004085</Color>
    <Color x:Key="Status.Secondary.SolidColor">           #FF748194</Color>
    <Color x:Key="Status.Secondary.SoftColor">            #FFE3E6EA</Color>
    <Color x:Key="Status.Success.SolidColor">             #FF28A745</Color>
    <Color x:Key="Status.Success.SoftColor">              #FFD4EDDA</Color>
    <Color x:Key="Status.Success.DarkColor">              #FF155724</Color>
    <Color x:Key="Status.Warning.SolidColor">             #FFFFC107</Color>
    <Color x:Key="Status.Warning.SoftColor">              #FFFDFAB1</Color>
    <Color x:Key="Status.Warning.DarkColor">              #FF856404</Color>
    <Color x:Key="Status.Danger.SolidColor">              #FFDC3545</Color>
    <Color x:Key="Status.Danger.SoftColor">               #FFFFCDD2</Color>
    <Color x:Key="Status.Danger.DarkColor">               #FF721C24</Color>

    <!--Badge-->
    <SolidColorBrush x:Key="Badge.Default.SolidBgBrush"   Color="{StaticResource Status.Default.SolidColor}" po:Freeze="True"/>
    <SolidColorBrush x:Key="Badge.Default.SoftBgBrush"    Color="{StaticResource Neutral.SoftColor}" po:Freeze="True"/>
    <SolidColorBrush x:Key="Badge.Default.FgBrush"        Color="{StaticResource Status.Default.DarkColor}" po:Freeze="True"/>
    <SolidColorBrush x:Key="Badge.Primary.SolidBgBrush"   Color="{StaticResource Status.Primary.SolidColor}" po:Freeze="True"/>
    <SolidColorBrush x:Key="Badge.Primary.SoftBgBrush"    Color="{StaticResource Status.Primary.SoftColor}" po:Freeze="True"/>
    <SolidColorBrush x:Key="Badge.Primary.FgBrush"        Color="{StaticResource Status.Primary.SolidColor}" po:Freeze="True"/>
    <SolidColorBrush x:Key="Badge.Secondary.SolidBgBrush" Color="{StaticResource Status.Secondary.SolidColor}" po:Freeze="True"/>
    <SolidColorBrush x:Key="Badge.Secondary.SoftBgBrush"  Color="{StaticResource Status.Secondary.SoftColor}" po:Freeze="True"/>
    <SolidColorBrush x:Key="Badge.Secondary.FgBrush"      Color="{StaticResource Status.Secondary.SolidColor}" po:Freeze="True"/>
    <SolidColorBrush x:Key="Badge.Success.SolidBgBrush"   Color="{StaticResource Status.Success.SolidColor}" po:Freeze="True"/>
    <SolidColorBrush x:Key="Badge.Success.SoftBgBrush"    Color="{StaticResource Status.Success.SoftColor}" po:Freeze="True"/>
    <SolidColorBrush x:Key="Badge.Success.FgBrush"        Color="{StaticResource Status.Success.SolidColor}" po:Freeze="True"/>
    <SolidColorBrush x:Key="Badge.Warning.SolidBgBrush"   Color="{StaticResource Status.Warning.SolidColor}" po:Freeze="True"/>
    <SolidColorBrush x:Key="Badge.Warning.SolidFgBrush"   Color="{StaticResource Status.Default.DarkColor}" po:Freeze="True"/>
    <SolidColorBrush x:Key="Badge.Warning.SoftBgBrush"    Color="{StaticResource Status.Warning.SoftColor}" po:Freeze="True"/>
    <SolidColorBrush x:Key="Badge.Warning.FgBrush"        Color="{StaticResource Status.Warning.DarkColor}" po:Freeze="True"/>
    <SolidColorBrush x:Key="Badge.Danger.SolidBgBrush"    Color="{StaticResource Status.Danger.SolidColor}" po:Freeze="True"/>
    <SolidColorBrush x:Key="Badge.Danger.SoftBgBrush"     Color="{StaticResource Status.Danger.SoftColor}" po:Freeze="True"/>
    <SolidColorBrush x:Key="Badge.Danger.FgBrush"         Color="{StaticResource Status.Danger.SolidColor}" po:Freeze="True"/>

    <!--Panels-->
    <SolidColorBrush x:Key="Panel.BgBrush"          Color="{StaticResource Panel.BgColor}" po:Freeze="True"/>
    <SolidColorBrush x:Key="Panel.Header.BgBrush"   Color="#FFB3D6E6" po:Freeze="True"/>
    <SolidColorBrush x:Key="Panel.BorderBrush"      Color="{StaticResource Border.Color}" po:Freeze="True"/>
    <SolidColorBrush x:Key="Panel.BorderLightBrush" Color="{StaticResource Border.LightColor}" po:Freeze="True"/>
    <SolidColorBrush x:Key="Panel.FgBrush"          Color="{StaticResource Text.FgColor}" po:Freeze="True"/>

    <!--Button-->
    <SolidColorBrush x:Key="Button.BorderBrush"       Color="#FF707070" po:Freeze="True"/>
    <SolidColorBrush x:Key="Button.Disabled.FgBrush"  Color="#FFADADAD" po:Freeze="True"/>
    <SolidColorBrush x:Key="Button.Focus.BorderBrush" Color="{StaticResource Neutral.BlackColor}" po:Freeze="True"/>

    <!--CheckBox, RadioButton-->
    <SolidColorBrush x:Key="CheckBox.BgBrush"           Color="{StaticResource Control.BgColor}" po:Freeze="True"/>
    <SolidColorBrush x:Key="CheckBox.BorderBrush"       Color="#FF8E8F8F" po:Freeze="True"/>
    <SolidColorBrush x:Key="CheckBox.Focus.BorderBrush" Color="{StaticResource Neutral.BlackColor}" po:Freeze="True"/>
    <SolidColorBrush x:Key="CheckBox.FgBrush"           Color="{StaticResource Text.FgColor}" po:Freeze="True"/>

    <!--ContextMenu-->
    <SolidColorBrush x:Key="ContextMenu.BgBrush" Color="{StaticResource Control.BgColor}" po:Freeze="True"/>

    <!--Expander-->
    <SolidColorBrush x:Key="Expander.Header.FgBrush"     Color="{StaticResource Text.FgColor}" po:Freeze="True"/>
    <SolidColorBrush x:Key="Expander.Header.BorderBrush" Color="{StaticResource Border.Color}" po:Freeze="True"/>

    <!--GroupBox-->
    <SolidColorBrush x:Key="GroupBox.FgBrush"               Color="{StaticResource Text.FgColor}" po:Freeze="True"/>
    <SolidColorBrush x:Key="GroupBox.Highlight.BorderBrush" Color="{StaticResource Neutral.WhiteColor}" po:Freeze="True"/>
    <SolidColorBrush x:Key="GroupBox.BorderBrush"           Color="{StaticResource Border.Color}" po:Freeze="True"/>

    <!--GridSplitter-->
    <SolidColorBrush x:Key="GridSplitter.Grip.LightBrush" Color="{StaticResource Neutral.WhiteColor}" po:Freeze="True"/>
    <SolidColorBrush x:Key="GridSplitter.Grip.DarkBrush"  Color="#FF204D89" po:Freeze="True"/>

    <!--HeaderedContentControl-->
    <SolidColorBrush x:Key="HeaderedControl.BorderBrush" Color="{StaticResource Border.Color}" po:Freeze="True"/>
    <SolidColorBrush x:Key="HeaderedControl.FgBrush"     Color="{StaticResource Text.FgColor}" po:Freeze="True"/>

    <!--ListView, ListBox-->
    <SolidColorBrush x:Key="List.BorderBrush" Color="{StaticResource Border.Color}" po:Freeze="True"/>
    <SolidColorBrush x:Key="List.FgBrush"     Color="{StaticResource Text.FgColor}" po:Freeze="True"/>

    <!--ListViewItem, ListBoxItem-->
    <SolidColorBrush x:Key="ListItem.Focus.BorderBrush"            Color="#8E6EA6F5" po:Freeze="True"/>
    <SolidColorBrush x:Key="ListItem.Hover.BorderBrush"            Color="#FFCCF0FF" po:Freeze="True"/>
    <SolidColorBrush x:Key="ListItem.Selected.BorderBrush"         Color="#FF98DDFB" po:Freeze="True"/>
    <SolidColorBrush x:Key="ListItem.Selected.InnerBorderBrush"    Color="#80FFFFFF" po:Freeze="True"/>
    <SolidColorBrush x:Key="ListItem.SelectedInactive.BorderBrush" Color="#FFCFCFCF" po:Freeze="True"/>
    <SolidColorBrush x:Key="ListItem.HighlightBrush"               Color="#75FFFFFF" po:Freeze="True"/>
    <SolidColorBrush x:Key="ListItem.Selected.HighlightBrush"      Color="#40FFFFFF" po:Freeze="True"/>

    <!--Menu, MenuItem-->
    <SolidColorBrush x:Key="Menu.BgBrush"                     Color="{StaticResource Menu.BgColor}" po:Freeze="True"/>
    <SolidColorBrush x:Key="MenuItem.Highlighted.BorderBrush" Color="{StaticResource Menu.Active.BorderColor}" po:Freeze="True"/>
    <SolidColorBrush x:Key="MenuItem.Pressed.BorderBrush"     Color="{StaticResource Menu.Active.BorderColor}" po:Freeze="True"/>
    <SolidColorBrush x:Key="MenuItem.Glyph.BorderBrush"       Color="{StaticResource Menu.Active.BorderColor}" po:Freeze="True"/>

    <!--StatusBar-->
    <SolidColorBrush x:Key="StatusBar.BorderBrush" Color="{StaticResource Border.LightColor}" po:Freeze="True"/>
    <SolidColorBrush x:Key="StatusBar.FgBrush"     Color="{StaticResource Text.FgColor}" po:Freeze="True"/>

    <!--NotificationItem-->
    <SolidColorBrush x:Key="NotificationItem.Info.BgBrush"                   Color="{StaticResource Status.Primary.SoftColor}" po:Freeze="True"/>
    <SolidColorBrush x:Key="NotificationItem.Info.GlyphBrush"                Color="{StaticResource Status.Primary.DarkColor}" po:Freeze="True"/>
    <SolidColorBrush x:Key="NotificationItem.Info.BorderTopLeftBrush"        Color="#B0CCE5FF" po:Freeze="True"/>
    <SolidColorBrush x:Key="NotificationItem.Info.BorderBottomRightBrush"    Color="#FFC1DBF7" po:Freeze="True"/>
    <SolidColorBrush x:Key="NotificationItem.Success.BgBrush"                Color="{StaticResource Status.Success.SoftColor}" po:Freeze="True"/>
    <SolidColorBrush x:Key="NotificationItem.Success.GlyphBrush"             Color="{StaticResource Status.Success.DarkColor}" po:Freeze="True"/>
    <SolidColorBrush x:Key="NotificationItem.Success.BorderTopLeftBrush"     Color="#80D4EDDA" po:Freeze="True"/>
    <SolidColorBrush x:Key="NotificationItem.Success.BorderBottomRightBrush" Color="#FFC6E5CD" po:Freeze="True"/>
    <SolidColorBrush x:Key="NotificationItem.Warning.BgBrush"                Color="{StaticResource Status.Warning.SoftColor}" po:Freeze="True"/>
    <SolidColorBrush x:Key="NotificationItem.Warning.GlyphBrush"             Color="{StaticResource Status.Warning.DarkColor}" po:Freeze="True"/>
    <SolidColorBrush x:Key="NotificationItem.Warning.BorderTopLeftBrush"     Color="#80FEFEDF" po:Freeze="True"/>
    <SolidColorBrush x:Key="NotificationItem.Warning.BorderBottomRightBrush" Color="#FFF3F0AA" po:Freeze="True"/>
    <SolidColorBrush x:Key="NotificationItem.Danger.BgBrush"                 Color="{StaticResource Status.Danger.SoftColor}" po:Freeze="True"/>
    <SolidColorBrush x:Key="NotificationItem.Danger.GlyphBrush"              Color="{StaticResource Status.Danger.DarkColor}" po:Freeze="True"/>
    <SolidColorBrush x:Key="NotificationItem.Danger.BorderTopLeftBrush"      Color="#B0FFCDD2" po:Freeze="True"/>
    <SolidColorBrush x:Key="NotificationItem.Danger.BorderBottomRightBrush"  Color="#FFF2C0C5" po:Freeze="True"/>

    <!--ClosableTabControl, ClosableTabItem-->
    <SolidColorBrush x:Key="ClosableTabControl.BgBrush"                  Color="{StaticResource ClosableTabControl.BgColor}" po:Freeze="True"/>
    <SolidColorBrush x:Key="ClosableTabControl.InnerBorderBrush"         Color="#FF8DB2E3" po:Freeze="True"/>
    <SolidColorBrush x:Key="ClosableTabItem.FgBrush"                     Color="{StaticResource Text.MutedFgColor}" po:Freeze="True"/>
    <SolidColorBrush x:Key="ClosableTabItem.Disabled.FgBrush"            Color="{StaticResource Neutral.GrayColor}" po:Freeze="True"/>
    <SolidColorBrush x:Key="ClosableTabItem.Hover.FgBrush"               Color="Indigo" po:Freeze="True"/>
    <SolidColorBrush x:Key="ClosableTabItem.Selected.FgBrush"            Color="DarkBlue" po:Freeze="True"/>
    <SolidColorBrush x:Key="ClosableTabItem.Selected.BorderBrush"        Color="{StaticResource Neutral.GrayColor}" po:Freeze="True"/>
    <SolidColorBrush x:Key="ClosableTabItem.CloseButton.FgBrush"         Color="{StaticResource Text.MutedFgColor}" po:Freeze="True"/>
    <SolidColorBrush x:Key="ClosableTabItem.CloseButton.Hover.FgBrush"   Color="{StaticResource Neutral.WhiteColor}" po:Freeze="True"/>
    <SolidColorBrush x:Key="ClosableTabItem.CloseButton.Pressed.FgBrush" Color="#EEEEEEEE" po:Freeze="True"/>

    <!--Scrollable tab strip buttons-->
    <SolidColorBrush x:Key="TabScrollButton.BorderBrush" Color="#FF8693BD" po:Freeze="True"/>
    <SolidColorBrush x:Key="TabScrollButton.FgBrush"     Color="{StaticResource Accent.Color}" po:Freeze="True"/>

    <!--TabControl, TabItem-->
    <SolidColorBrush x:Key="TabControl.BgBrush"            Color="{StaticResource Panel.BgColor}" po:Freeze="True"/>
    <SolidColorBrush x:Key="TabControl.BorderBrush"        Color="{StaticResource Border.LightColor}" po:Freeze="True"/>
    <SolidColorBrush x:Key="TabControl.Header.BorderBrush" Color="{StaticResource Border.Color}" po:Freeze="True"/>
    <SolidColorBrush x:Key="TabItem.FgBrush"               Color="{StaticResource Text.FgColor}" po:Freeze="True"/>
    <SolidColorBrush x:Key="TabItem.Selected.FgBrush"      Color="{StaticResource Accent.Color}" po:Freeze="True"/>
    <SolidColorBrush x:Key="TabItem.BorderBrush"           Color="{StaticResource Border.Color}" po:Freeze="True"/>

    <!--TextBlock-->
    <SolidColorBrush x:Key="TextBlock.Disabled.OpacityMask" Color="#A0FFFFFF" po:Freeze="True"/>

    <!--TextBox, PasswordBox, Editable ComboBox-->
    <SolidColorBrush x:Key="PasswordBox.BgBrush"              Color="{StaticResource Neutral.WhiteColor}" po:Freeze="True"/>
    <SolidColorBrush x:Key="TextBox.BorderBrush"              Color="#FFABC1DE" po:Freeze="True"/>
    <SolidColorBrush x:Key="TextBox.Focused.BorderBrush"      Color="{StaticResource Accent.Color}" po:Freeze="True"/>
    <SolidColorBrush x:Key="TextBox.Hover.BorderBrush"        Color="{StaticResource Border.Color}" po:Freeze="True"/>
    <SolidColorBrush x:Key="TextBox.Disabled.BgBrush"         Color="Transparent" po:Freeze="True"/>
    <SolidColorBrush x:Key="TextBox.HasError.BorderBrush"     Color="Red" po:Freeze="True"/>
    <SolidColorBrush x:Key="TextBox.HasError.BorderSoftBrush" Color="#FFFF7F7F" po:Freeze="True"/>

    <!--ToolBar-->
    <SolidColorBrush x:Key="ToolBarTray.BgBrush"              Color="{StaticResource Menu.BgColor}" po:Freeze="True"/>
    <SolidColorBrush x:Key="ToolBar.Hover.BorderBrush"        Color="{StaticResource Menu.Active.BorderColor}" po:Freeze="True"/>
    <SolidColorBrush x:Key="ToolBar.Pressed.BorderBrush"      Color="{StaticResource Menu.Active.BorderColor}" po:Freeze="True"/>
    <SolidColorBrush x:Key="ToolBar.Checked.BorderBrush"      Color="{StaticResource Menu.Active.BorderColor}" po:Freeze="True"/>
    <SolidColorBrush x:Key="ToolBar.Bottom.BorderBrush"       Color="{StaticResource Border.Color}" po:Freeze="True"/>
    <SolidColorBrush x:Key="ToolBar.Overflow.Hover.BgBrush"   Color="#FFFFEBA6" po:Freeze="True"/>
    <SolidColorBrush x:Key="ToolBar.Overflow.Pressed.BgBrush" Color="#FFFDA461" po:Freeze="True"/>

    <!--TreeView-->
    <SolidColorBrush x:Key="TreeViewItem.Connection.BgBrush"        Color="{StaticResource Neutral.WhiteColor}" po:Freeze="True"/>
    <SolidColorBrush x:Key="TreeViewItem.Expander.GlyphBrush"       Color="{StaticResource Neutral.BlackColor}" po:Freeze="True"/>
    <SolidColorBrush x:Key="TreeViewItem.Connection.LineBrush"      Color="#FFDCDCDC" po:Freeze="True"/>
    <SolidColorBrush x:Key="TreeViewItem.Expander.BorderBrush"      Color="#FF919191" po:Freeze="True"/>
    <SolidColorBrush x:Key="TreeViewItem.Selected.Active.BgBrush"   Color="{StaticResource Menu.BgColor}" po:Freeze="True"/>
    <SolidColorBrush x:Key="TreeViewItem.Selected.Inactive.BgBrush" Color="{StaticResource Neutral.SoftColor}" po:Freeze="True"/>
</ResourceDictionary>