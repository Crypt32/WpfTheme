<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="SolidColors.xaml"/>
    </ResourceDictionary.MergedDictionaries>
    <!-- Shared stop collections: only stop sets used by more than one brush. Directed brushes below link to them. -->
    <LinearGradientBrush x:Key="CloseTabButton.BgGradient" StartPoint="0,0" EndPoint="1,0" po:Freeze="True">
        <GradientBrush.GradientStops>
            <GradientStopCollection>
                <GradientStop Color="#5FFF" Offset="0.0"/>
                <GradientStop Color="#5CCC" Offset="1.0"/>
            </GradientStopCollection>
        </GradientBrush.GradientStops>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="CloseTabButton.BorderGradient" StartPoint="0,0" EndPoint="1,1" po:Freeze="True">
        <GradientBrush.GradientStops>
            <GradientStopCollection>
                <GradientStop Color="#5CCC" Offset="0.0"/>
                <GradientStop Color="#5444" Offset="1.0"/>
            </GradientStopCollection>
        </GradientBrush.GradientStops>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="CloseTabButton.Hover.BgGradient" StartPoint="0,1" EndPoint="1,0" po:Freeze="True">
        <GradientBrush.GradientStops>
            <GradientStopCollection>
                <GradientStop Color="#FFDF2B1E" Offset="0.0"/>
                <GradientStop Color="#FFA41F00" Offset="1.0"/>
            </GradientStopCollection>
        </GradientBrush.GradientStops>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="CloseTabButton.Pressed.BgGradient" StartPoint="0,0" EndPoint="1,1" po:Freeze="True">
        <GradientBrush.GradientStops>
            <GradientStopCollection>
                <GradientStop Color="#FFA41F00" Offset="0.0"/>
                <GradientStop Color="#FFDF2B1E" Offset="1.0"/>
            </GradientStopCollection>
        </GradientBrush.GradientStops>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="CloseTabButton.Pressed.BorderGradient" StartPoint="0,0" EndPoint="1,1" po:Freeze="True">
        <GradientBrush.GradientStops>
            <GradientStopCollection>
                <GradientStop Color="#5444" Offset="0.0"/>
                <GradientStop Color="#5CCC" Offset="1.0"/>
            </GradientStopCollection>
        </GradientBrush.GradientStops>
    </LinearGradientBrush>
    <GradientStopCollection x:Key="Gradient.Blue.Stops" po:Freeze="True">
        <GradientStop Color="{StaticResource Panel.BgColor}" Offset="0"/>
        <GradientStop Color="{StaticResource Border.LightColor}" Offset="1"/>
    </GradientStopCollection>
    <GradientStopCollection x:Key="Gradient.Yellow.Hover.Stops" po:Freeze="True">
        <GradientStop Color="#FEFBEC" Offset="0"/>
        <GradientStop Color="#FEDC5D" Offset="0.5"/>
        <GradientStop Color="#FEECA8" Offset="1"/>
    </GradientStopCollection>
    <GradientStopCollection x:Key="ScrollBar.Thumb.Hover.Stops" po:Freeze="True">
        <GradientStop Color="#FFDAE9FF" Offset="0"/>
        <GradientStop Color="#FFD4E6FF" Offset="0.65"/>
        <GradientStop Color="#FFCAE0FF" Offset="1"/>
    </GradientStopCollection>
    <GradientStopCollection x:Key="ScrollBar.Thumb.Pressed.Stops" po:Freeze="True">
        <GradientStop Color="#FFA8BEF5" Offset="0"/>
        <GradientStop Color="#FFA1BDFA" Offset="0.65"/>
        <GradientStop Color="#FF98B0EE" Offset="1"/>
    </GradientStopCollection>
    <GradientStopCollection x:Key="ScrollBar.Thumb.Stops" po:Freeze="True">
        <GradientStop Color="#FFC9D8FC" Offset="0"/>
        <GradientStop Color="#FFC2D3FC" Offset="0.65"/>
        <GradientStop Color="#FFB6CDFB" Offset="1"/>
    </GradientStopCollection>
    <GradientStopCollection x:Key="ScrollBar.Track.Pressed.Stops" po:Freeze="True">
        <GradientStop Color="#FFD7D5C2" Offset="0"/>
        <GradientStop Color="#FFD7D5C2" Offset="0.05"/>
        <GradientStop Color="#FFE3DED3" Offset="0.06"/>
        <GradientStop Color="#FFFDFDF6" Offset="0.94"/>
        <GradientStop Color="#FFD7D5C2" Offset="0.95"/>
        <GradientStop Color="#FFD7D5C2" Offset="1"/>
    </GradientStopCollection>
    <GradientStopCollection x:Key="ScrollBar.Track.Stops" po:Freeze="True">
        <GradientStop Color="#FFEEEDE5" Offset="0"/>
        <GradientStop Color="#FFEEEDE5" Offset="0.05"/>
        <GradientStop Color="#FFF3F1EC" Offset="0.06"/>
        <GradientStop Color="{StaticResource Neutral.WhiteColor}" Offset="0.94"/>
        <GradientStop Color="#FFEEEDE5" Offset="0.95"/>
        <GradientStop Color="#FFEEEDE5" Offset="1"/>
    </GradientStopCollection>

    <!-- Button -->
    <LinearGradientBrush x:Key="Button.BgGradient" StartPoint="0,0" EndPoint="0,1" po:Freeze="True">
        <GradientStop Color="{StaticResource Control.BgColor}" Offset="0"/>
        <GradientStop Color="#EBEBEB" Offset="0.5"/>
        <GradientStop Color="{StaticResource Neutral.LineColor}" Offset="0.5"/>
        <GradientStop Color="#CDCDCD" Offset="1"/>
    </LinearGradientBrush>

    <!-- CheckBox, RadioButton: the inner box (and, for RadioButton, the dot) of the bullet. -->
    <LinearGradientBrush x:Key="CheckBox.Inner.BgGradient" StartPoint="0,0" EndPoint="1,1" po:Freeze="True">
        <GradientStop Color="{StaticResource Neutral.SoftColor}" Offset="0.2"/>
        <GradientStop Color="{StaticResource Neutral.PaleColor}" Offset="0.8"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="CheckBox.Inner.BorderGradient" StartPoint="0,0" EndPoint="1,1" po:Freeze="True">
        <GradientStop Color="{StaticResource Neutral.DisabledLightColor}" Offset="0.25"/>
        <GradientStop Color="{StaticResource Neutral.LineColor}" Offset="1.0"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="CheckBox.Inner.Hover.BgGradient" StartPoint="0,0" EndPoint="1,1" po:Freeze="True">
        <GradientStop Color="{StaticResource Border.LightColor}" Offset="0.2"/>
        <GradientStop Color="{StaticResource Panel.PaleBlueColor}" Offset="0.8"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="CheckBox.Inner.Hover.BorderGradient" StartPoint="0,0" EndPoint="1,1" po:Freeze="True">
        <GradientStop Color="{StaticResource Border.AccentColor}" Offset="0.3"/>
        <GradientStop Color="{StaticResource Border.LightColor}" Offset="1.0"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="CheckBox.Inner.Pressed.BgGradient" StartPoint="0,0" EndPoint="1,1" po:Freeze="True">
        <GradientStop Color="{StaticResource Border.AccentColor}" Offset="0.2"/>
        <GradientStop Color="{StaticResource Status.Primary.SoftColor}" Offset="0.8"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="CheckBox.Inner.Pressed.BorderGradient" StartPoint="0,0" EndPoint="1,1" po:Freeze="True">
        <GradientStop Color="{StaticResource Border.PressedColor}" Offset="0.3"/>
        <GradientStop Color="{StaticResource Status.Primary.SoftColor}" Offset="1.0"/>
    </LinearGradientBrush>
    <RadialGradientBrush x:Key="RadioButton.Dot.BgGradient" Center="0.25,0.25" GradientOrigin="0.25,0.25" RadiusX="0.75" RadiusY="0.75" po:Freeze="True">
        <GradientStop Color="{StaticResource Panel.BgColor}" Offset="0.1"/>
        <GradientStop Color="{StaticResource Border.AccentColor}" Offset="0.35"/>
        <GradientStop Color="{StaticResource Status.Primary.SolidColor}" Offset="1.0"/>
    </RadialGradientBrush>

    <!-- ClosableTabItem -->
    <LinearGradientBrush x:Key="ClosableTabItem.BgGradient" StartPoint="0,0" EndPoint="0,1" po:Freeze="True">
        <LinearGradientBrush.GradientStops>
            <GradientStop Color="#E8F2FF" Offset="0.0"/>
            <GradientStop Color="#DFE9F6" Offset="0.3"/>
            <GradientStop Color="#C7D8EE" Offset="0.7"/>
            <GradientStop Color="#B9CADE" Offset="0.98"/>
            <!-- See the ScrollableTabControl.Panel.BgGradient comment. -->
            <GradientStop Color="{StaticResource Neutral.GrayColor}" Offset="0.99"/>
        </LinearGradientBrush.GradientStops>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ClosableTabItem.Disabled.BgGradient" StartPoint="0,0" EndPoint="0,1" po:Freeze="True">
        <LinearGradientBrush.GradientStops>
            <GradientStop Color="{StaticResource Neutral.PaleColor}" Offset="0"/>
            <GradientStop Color="#BBB" Offset="0.98"/>
            <!-- 
               This is the same trick as with the ScrollableTabControl.Panel.BgGradient (see there).
            -->
            <GradientStop Color="{StaticResource Neutral.GrayColor}" Offset="0.99"/>
        </LinearGradientBrush.GradientStops>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ClosableTabItem.Disabled.BorderGradient" StartPoint="0,0" EndPoint="0,1" po:Freeze="True">
        <GradientStop Color="#CCC" Offset="0"/>
        <GradientStop Color="{StaticResource Neutral.GrayColor}" Offset="0.8"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ClosableTabItem.Selected.BgGradient" 
                           StartPoint="0,0" EndPoint="0,1" po:Freeze="True">
        <LinearGradientBrush.GradientStops>
            <GradientStop Color="#FFFFC14A" Offset="0.1" />
            <GradientStop Color="{StaticResource Panel.PaleBlueColor}" Offset="0.15"/>
            <GradientStop Color="#C5DBF6" Offset="0.8"/>
            <GradientStop Color="{StaticResource Panel.PaleBlueColor}" Offset="1.0"/>
        </LinearGradientBrush.GradientStops>
    </LinearGradientBrush>

    <!-- ComboBox -->
    <LinearGradientBrush x:Key="ComboBox.BgGradient" EndPoint="0,1" StartPoint="0,0" po:Freeze="True">
        <GradientStop Color="{StaticResource Neutral.PaleColor}" Offset="0.0"/>
        <GradientStop Color="#FFE5E5E5" Offset="1.0"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ComboBox.Hover.BgGradient" EndPoint="0,1" StartPoint="0,0" po:Freeze="True">
        <GradientStop Color="{StaticResource Panel.PaleBlueColor}" Offset="0.0"/>
        <GradientStop Color="#FFDCECFC" Offset="1.0"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ComboBox.Pressed.BgGradient" EndPoint="0,1" StartPoint="0,0" po:Freeze="True">
        <GradientStop Color="#FFDAECFC" Offset="0.0"/>
        <GradientStop Color="#FFC4E0FC" Offset="1.0"/>
    </LinearGradientBrush>

    <!-- DataGrid -->
    <!-- Column headers (DataGrid and GridView) and the select-all corner share these; the corner is one step darker. -->
    <LinearGradientBrush x:Key="DataGrid.Header.BgGradient" StartPoint="0,0" EndPoint="0,1" po:Freeze="True">
        <GradientStop Color="#FFF9FCFD" Offset="0"/>
        <GradientStop Color="#FFD3DBE9" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="DataGrid.Header.Hover.BgGradient" StartPoint="0,0" EndPoint="0,1" po:Freeze="True">
        <GradientStop Color="#FFDEE4EB" Offset="0"/>
        <GradientStop Color="#FFBCC4D0" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="DataGrid.Corner.Hover.BgGradient" StartPoint="0,0" EndPoint="0,1" po:Freeze="True">
        <GradientStop Color="#FFCDD5E1" Offset="0"/>
        <GradientStop Color="#FFA9B3C2" Offset="1"/>
    </LinearGradientBrush>

    <!-- Gradient -->
    <LinearGradientBrush x:Key="Gradient.Blue.Down"           StartPoint="0,0" EndPoint="0,1" GradientStops="{StaticResource Gradient.Blue.Stops}" po:Freeze="True"/>
    <LinearGradientBrush x:Key="Gradient.Blue.Right"          StartPoint="0,0" EndPoint="1,0" GradientStops="{StaticResource Gradient.Blue.Stops}" po:Freeze="True"/>
    <LinearGradientBrush x:Key="Gradient.Yellow.Hover.Down"   StartPoint="0,0" EndPoint="0,1" GradientStops="{StaticResource Gradient.Yellow.Hover.Stops}" po:Freeze="True"/>
    <LinearGradientBrush x:Key="Gradient.Yellow.Hover.Right"  StartPoint="0,0" EndPoint="1,0" GradientStops="{StaticResource Gradient.Yellow.Hover.Stops}" po:Freeze="True"/>
    <LinearGradientBrush x:Key="Gradient.Yellow.Pressed.Down" StartPoint="0,0" EndPoint="0,1" po:Freeze="True">
        <GradientStop Color="#FFED91" Offset="0"/>
        <GradientStop Color="#FED22B" Offset="0.5"/>
        <GradientStop Color="#FCA301" Offset="1"/>
    </LinearGradientBrush>

    <!-- ListViewItem -->
    <LinearGradientBrush x:Key="ListViewItem.Hover.BgGradient" StartPoint="0,0" EndPoint="0,1" po:Freeze="True">
        <GradientStop Color="#FFF1FBFF" Offset="0"/>
        <GradientStop Color="#FFD5F1FE" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ListViewItem.Selected.BgGradient" StartPoint="0,0" EndPoint="0,1" po:Freeze="True">
        <GradientStop Color="#FFD9F4FF" Offset="0"/>
        <GradientStop Color="#FF9BDDFB" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ListViewItem.Selected.Hover.BgGradient" StartPoint="0,0" EndPoint="0,1" po:Freeze="True">
        <GradientStop Color="#FFEAF9FF" Offset="0"/>
        <GradientStop Color="#FFC9EDFD" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ListViewItem.Selected.Inactive.BgGradient" StartPoint="0,0" EndPoint="0,1" po:Freeze="True">
        <GradientStop Color="{StaticResource Neutral.PaleColor}" Offset="0"/>
        <GradientStop Color="{StaticResource Neutral.LineColor}" Offset="1"/>
    </LinearGradientBrush>

    <!-- Menu / MenuItem -->
    <LinearGradientBrush x:Key="Menu.Hover.BgGradient" StartPoint="0,0" EndPoint="0,1" po:Freeze="True">
        <GradientStop Color="#FEF4CB" Offset="0"/>
        <GradientStop Color="#FEE6A0" Offset="0.5"/>
        <GradientStop Color="#FEDB7A" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Menu.Pressed.BgGradient" StartPoint="0,0" EndPoint="0,1" po:Freeze="True">
        <GradientStop Color="{StaticResource Panel.BgColor}" Offset="0"/>
        <GradientStop Color="#B8D3F5" Offset="0.5"/>
        <GradientStop Color="#8FB8ED" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="MenuItem.Submenu.Hover.BgGradient" StartPoint="0,0" EndPoint="0,1" po:Freeze="True">
        <GradientStop Color="#FEFEF9" Offset="0"/>
        <GradientStop Color="#FEEA9F" Offset="0.49"/>
        <GradientStop Color="#FEDC5D" Offset="0.5"/>
        <GradientStop Color="#FEECA8" Offset="1"/>
    </LinearGradientBrush>

    <!-- ProgressBar -->
    <LinearGradientBrush x:Key="ProgressBar.BgGradient" StartPoint="0,0" EndPoint="0,1" po:Freeze="True">
        <GradientStop Color="#BABABA" Offset="0"/>
        <GradientStop Color="#C7C7C7" Offset="0.5"/>
        <GradientStop Color="#BABABA" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ProgressBar.BorderGradient" StartPoint="0,0" EndPoint="0,1" po:Freeze="True">
        <GradientStop Color="#B2B2B2" Offset="0"/>
        <GradientStop Color="#8C8C8C" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ProgressBar.Glass.BgGradient" StartPoint="0,0" EndPoint="0,1" po:Freeze="True">
        <GradientStop Color="#50FFFFFF" Offset="0.5385"/>
        <GradientStop Color="#00FFFFFF" Offset="0.5385"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ProgressBar.Indicator.Animated.BgGradient"
                         MappingMode="Absolute"
                         StartPoint="-100,0"
                         EndPoint="0,0"
                         po:Freeze="True">
        <GradientStop Color="#00000000" Offset="0"/>
        <GradientStop Color="{StaticResource Neutral.BlackColor}" Offset="0.4"/>
        <GradientStop Color="{StaticResource Neutral.BlackColor}" Offset="0.6"/>
        <GradientStop Color="#00000000" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ProgressBar.Indicator.Glass.BgGradient" StartPoint="0,0" EndPoint="0,1" po:Freeze="True">
        <GradientStop Color="#90FFFFFF" Offset="0.5385"/>
        <GradientStop Color="#00FFFFFF" Offset="0.5385"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ProgressBar.TopHighlight.BgGradient" StartPoint="0,0" EndPoint="0,1" po:Freeze="True">
        <GradientStop Color="#80FFFFFF" Offset="0.05"/>
        <GradientStop Color="#00FFFFFF" Offset="0.25"/>
    </LinearGradientBrush>

    <!-- ScrollableTabControl -->
    <!-- Brushes used for styling the TabControl -->
    <!-- The color to be used for painting the interior of the TabItem-menu's path -->
    <LinearGradientBrush x:Key="ScrollableTabControl.MenuButton.BgGradient" StartPoint="0,0" EndPoint="1,1" po:Freeze="True">
        <GradientStop Offset="0" Color="White"/>
        <GradientStop Offset="1" Color="#F3F3E3"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ScrollableTabControl.Panel.BgGradient" StartPoint="0,0" EndPoint="0,1" po:Freeze="True">
        <LinearGradientBrush.GradientStops>
            <!-- Tabbed documents sit right under the menu and toolbar tray, which have no border: the strip must be the same color. -->
            <GradientStop Offset="0.98" Color="{StaticResource Menu.BgColor}"/>
            <GradientStop Offset="0.99" Color="{StaticResource Neutral.GrayColor}"/>
        </LinearGradientBrush.GradientStops>
    </LinearGradientBrush>

    <!-- ScrollBar -->
    <!-- Scroll bar line (arrow) button. -->
    <LinearGradientBrush x:Key="ScrollBar.Button.BgGradient" StartPoint="0,0" EndPoint="1,1" po:Freeze="True">
        <GradientStop Color="#FFE1EAFE" Offset="0"/>
        <GradientStop Color="#FFC3D3FD" Offset="0.3"/>
        <GradientStop Color="#FFC3D3FD" Offset="0.6"/>
        <GradientStop Color="#FFBBCDF9" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ScrollBar.Button.Disabled.BgGradient" StartPoint="0,0" EndPoint="1,1" po:Freeze="True">
        <GradientStop Color="{StaticResource Control.BgColor}" Offset="0"/>
        <GradientStop Color="{StaticResource Neutral.PaleColor}" Offset="0.3"/>
        <GradientStop Color="#FFECECEC" Offset="0.6"/>
        <GradientStop Color="#FFE3E3E3" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ScrollBar.Button.Hover.BgGradient" StartPoint="0,0" EndPoint="1,1" po:Freeze="True">
        <GradientStop Color="{StaticResource Neutral.WhiteColor}" Offset="0"/>
        <GradientStop Color="#FFE2F3FD" Offset="0.25"/>
        <GradientStop Color="#FFB9DAFB" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ScrollBar.Button.Pressed.BgGradient" StartPoint="0,0" EndPoint="1,1" po:Freeze="True">
        <GradientStop Color="#FF6E8EF1" Offset="0"/>
        <GradientStop Color="#FF009DF1" Offset="0.3"/>
        <GradientStop Color="#FFAFBFED" Offset="0.7"/>
        <GradientStop Color="#FFD2DEEB" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ScrollBar.Shadow.BgGradient" StartPoint="0,0" EndPoint="0,1" po:Freeze="True">
        <GradientStop Color="#00A0B5D3" Offset="0"/>
        <GradientStop Color="#FFA0B5D3" Offset="0.5"/>
        <GradientStop Color="#FF7C9FD3" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ScrollBar.Shadow.Disabled.BgGradient" StartPoint="0,0" EndPoint="0,1" po:Freeze="True">
        <GradientStop Color="#00CCCCBA" Offset="0"/>
        <GradientStop Color="#FFCCCCBA" Offset="0.5"/>
        <GradientStop Color="#FFC4C4AF" Offset="1"/>
    </LinearGradientBrush>
    <!-- Scroll bar thumb. Vertical brushes are for the vertical scroll bar and run left to right. -->
    <LinearGradientBrush x:Key="ScrollBar.Thumb.Horizontal.BgGradient" StartPoint="0,0" EndPoint="0,1" GradientStops="{StaticResource ScrollBar.Thumb.Stops}" po:Freeze="True"/>
    <LinearGradientBrush x:Key="ScrollBar.Thumb.Hover.Horizontal.BgGradient" StartPoint="0,0" EndPoint="0,1" GradientStops="{StaticResource ScrollBar.Thumb.Hover.Stops}" po:Freeze="True"/>
    <LinearGradientBrush x:Key="ScrollBar.Thumb.Hover.Vertical.BgGradient" StartPoint="0,0" EndPoint="1,0" GradientStops="{StaticResource ScrollBar.Thumb.Hover.Stops}" po:Freeze="True"/>
    <LinearGradientBrush x:Key="ScrollBar.Thumb.Pressed.Horizontal.BgGradient" StartPoint="0,0" EndPoint="0,1" GradientStops="{StaticResource ScrollBar.Thumb.Pressed.Stops}" po:Freeze="True"/>
    <LinearGradientBrush x:Key="ScrollBar.Thumb.Pressed.Vertical.BgGradient" StartPoint="0,0" EndPoint="1,0" GradientStops="{StaticResource ScrollBar.Thumb.Pressed.Stops}" po:Freeze="True"/>
    <LinearGradientBrush x:Key="ScrollBar.Thumb.Vertical.BgGradient" StartPoint="0,0" EndPoint="1,0" GradientStops="{StaticResource ScrollBar.Thumb.Stops}" po:Freeze="True"/>
    <!-- Scroll bar track. Vertical brushes are for the vertical scroll bar and run left to right. -->
    <LinearGradientBrush x:Key="ScrollBar.Track.Horizontal.BgGradient" StartPoint="0,0" EndPoint="0,1" GradientStops="{StaticResource ScrollBar.Track.Stops}" po:Freeze="True"/>
    <LinearGradientBrush x:Key="ScrollBar.Track.Pressed.Horizontal.BgGradient" StartPoint="0,0" EndPoint="0,1" GradientStops="{StaticResource ScrollBar.Track.Pressed.Stops}" po:Freeze="True"/>
    <LinearGradientBrush x:Key="ScrollBar.Track.Pressed.Vertical.BgGradient" StartPoint="0,0" EndPoint="1,0" GradientStops="{StaticResource ScrollBar.Track.Pressed.Stops}" po:Freeze="True"/>
    <LinearGradientBrush x:Key="ScrollBar.Track.Vertical.BgGradient" StartPoint="0,0" EndPoint="1,0" GradientStops="{StaticResource ScrollBar.Track.Stops}" po:Freeze="True"/>

    <!-- StatusBar -->
    <LinearGradientBrush x:Key="StatusBar.BgGradient" StartPoint="0,0" EndPoint="0,1" po:Freeze="True">
        <GradientStop Color="#FFD7E6F9" Offset="0"/>
        <GradientStop Color="#FFC7DCF8" Offset="0.33"/>
        <GradientStop Color="#FFB3D0F5" Offset="0.33"/>
        <GradientStop Color="#FFD7E5F7" Offset="0.9"/>
        <GradientStop Color="#FFBAD4F7" Offset="1"/>
    </LinearGradientBrush>

    <!-- TabItem -->
    <LinearGradientBrush x:Key="TabItem.Selected.BgGradient" StartPoint="0,0" EndPoint="0,1" po:Freeze="True">
        <GradientStop Color="#FEFBEC" Offset="1"/>
        <GradientStop Color="#FEDC5D" Offset="0"/>
    </LinearGradientBrush>

    <!-- ToolBar -->
    <LinearGradientBrush x:Key="ToolBar.BgGradient" StartPoint="0,0" EndPoint="0,1" po:Freeze="True">
        <GradientStop Color="{StaticResource Panel.BgColor}" Offset="0"/>
        <GradientStop Color="{StaticResource Panel.BgColor}" Offset="0.5"/>
        <GradientStop Color="{StaticResource Border.LightColor}" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ToolBar.Overflow.BgGradient" StartPoint="0,0" EndPoint="0,1" po:Freeze="True">
        <GradientStop Color="#A7CCFB" Offset="0"/>
        <GradientStop Color="#A7CCFB" Offset="0.5"/>
        <GradientStop Color="{StaticResource Border.Color}" Offset="1"/>
    </LinearGradientBrush>

    <!-- TreeViewItem -->
    <LinearGradientBrush x:Key="TreeViewItem.Toggle.BgGradient" EndPoint="0.5,2" StartPoint="0.5,0" po:Freeze="True">
        <GradientStop Color="White" Offset="0"/>
        <GradientStop Color="Silver" Offset="0.5"/>
        <GradientStop Color="LightGray" Offset="1"/>
    </LinearGradientBrush>
</ResourceDictionary>
