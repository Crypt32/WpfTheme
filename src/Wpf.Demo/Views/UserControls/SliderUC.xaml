<UserControl x:Class="Wpf.Demo.Views.UserControls.SliderUC"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <Style TargetType="Slider" BasedOn="{StaticResource {x:Type Slider}}">
            <Setter Property="Maximum" Value="30"/>
            <Setter Property="TickFrequency" Value="3"/>
            <Setter Property="Value" Value="12"/>
            <Setter Property="TickPlacement" Value="BottomRight"/>
        </Style>
    </UserControl.Resources>
    <DockPanel>
        <Slider Orientation="Vertical"/>
        <Slider Orientation="Vertical" IsEnabled="False"/>

        <Slider Orientation="Vertical" TickPlacement="TopLeft" IsEnabled="False"/>
        <Slider Orientation="Vertical" TickPlacement="TopLeft"/>
        
        <Slider Orientation="Vertical" TickPlacement="Both"/>
        <Slider Orientation="Vertical" TickPlacement="Both" IsEnabled="False"/>

        <StackPanel>
            <Slider Orientation="Horizontal" IsSnapToTickEnabled="True"/>
            <Slider Orientation="Horizontal" IsEnabled="False"/>

            <Slider Orientation="Horizontal" TickPlacement="TopLeft" IsSnapToTickEnabled="True"/>
            <Slider Orientation="Horizontal" TickPlacement="TopLeft" IsEnabled="False"/>

            <Slider Orientation="Horizontal" TickPlacement="Both" IsSnapToTickEnabled="True"/>
            <Slider Orientation="Horizontal" TickPlacement="Both" IsEnabled="False"/>
        </StackPanel>
    </DockPanel>
</UserControl>
