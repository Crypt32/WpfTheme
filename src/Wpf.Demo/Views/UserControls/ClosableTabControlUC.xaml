<UserControl x:Class="Wpf.Demo.Views.UserControls.ClosableTabControlUC"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:wpf="http://schemas.sysadmins.lv/wpf"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <StackPanel>
        <!--<wpf:ClosableTabControl TabStripPlacement="Top"
                                Style="{StaticResource ScrollableTabControl}">
            <wpf:ClosableTabItem Header="http://schemas.microsoft.com/expression/blend/2008"
                                 IsClosable="True">
                <TextBlock Text="Text1"/>
            </wpf:ClosableTabItem>
            <wpf:ClosableTabItem Header="http://schemas.microsoft.com/winfx/2006/xaml"
                                 IsClosable="True">
                <TextBlock Text="Text2"/>
            </wpf:ClosableTabItem>
        </wpf:ClosableTabControl>-->
        <wpf:ClosableTabControl ItemsSource="{Binding Tabs, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                Style="{StaticResource ScrollableTabControl}"
                                ShowNewTabButton="True">
            <wpf:ClosableTabControl.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Header}" FontSize="24"/>
                </DataTemplate>
            </wpf:ClosableTabControl.ItemTemplate>
            <wpf:ClosableTabControl.ContentTemplate>
                <DataTemplate>
                    <TextBox Text="{Binding Content}"/>
                </DataTemplate>
            </wpf:ClosableTabControl.ContentTemplate>
        </wpf:ClosableTabControl>
    </StackPanel>
</UserControl>
