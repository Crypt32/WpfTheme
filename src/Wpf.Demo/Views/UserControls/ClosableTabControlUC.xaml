<UserControl x:Class="Wpf.Demo.Views.UserControls.ClosableTabControlUC"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:wpf="http://schemas.sysadmins.lv/wpf"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <StackPanel Background="White">
        <wpf:ClosableTabControl TabStripPlacement="Top"
                                Height="100"
                                FontSize="{Binding ElementName=Slider, Path=Value}"
                                ShowNewTabButton="True"
                                Style="{StaticResource ScrollableTabControl}">
            <wpf:ClosableTabItem Header="Scrollable without close">
                <TextBox Text="Text1"/>
            </wpf:ClosableTabItem>
            <wpf:ClosableTabItem Header="Disabled" IsClosable="False" IsEnabled="False">
                <TextBox Text="Text1"/>
            </wpf:ClosableTabItem>
            <wpf:ClosableTabItem Header="http://schemas.microsoft.com/expression/blend/2008"
                                 IsClosable="True">
                <TextBlock Text="Text1"/>
            </wpf:ClosableTabItem>
            <wpf:ClosableTabItem Header="http://schemas.microsoft.com/winfx/2006/xaml"
                                 IsClosable="True">
                <TextBlock Text="Text2"/>
            </wpf:ClosableTabItem>
        </wpf:ClosableTabControl>
        <Slider x:Name="Slider"
                Maximum="30"
                TickFrequency="3"
                Value="12"
                TickPlacement="BottomRight"/>
        <wpf:ClosableTabControl ItemsSource="{Binding Tabs, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                MenuDisplayMemberPath="Title"
                                ShowNewTabButton="True"
                                Height="100"
                                Margin="0,10,0,0">
            <wpf:ClosableTabControl.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Title}" FontSize="24"/>
                </DataTemplate>
            </wpf:ClosableTabControl.ItemTemplate>
            <wpf:ClosableTabControl.ContentTemplate>
                <DataTemplate>
                    <TextBox Text="{Binding Content}"/>
                </DataTemplate>
            </wpf:ClosableTabControl.ContentTemplate>
        </wpf:ClosableTabControl>
    </StackPanel>
</UserControl>
