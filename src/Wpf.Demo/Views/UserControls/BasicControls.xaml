<UserControl x:Class="Wpf.Demo.Views.UserControls.BasicControls"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:Wpf.Demo.ViewModels"
             xmlns:wpf="http://schemas.sysadmins.lv/wpf"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:FormViewModel}"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Column="0" Grid.Row="0">
            <CheckBox Content="Unchecked"/>
            <CheckBox Content="Checked" IsChecked="True"/>
            <CheckBox Content="ThreeState" IsThreeState="True" IsChecked="{x:Null}"/>

            <TextBlock Text="TextBox" Margin="0,5,0,0"/>
            <TextBox Text="{Binding Number, UpdateSourceTrigger=PropertyChanged}"/>
            <TextBlock Text="TextBox read-only"/>
            <TextBox IsReadOnly="True" Text="Read-Only"/>

            <TextBlock Text="PasswordBox"/>
            <PasswordBox/>
        </StackPanel>
        <StackPanel Grid.Column="1" Grid.Row="0" Margin="5,0,0,0">
            <RadioButton GroupName="one" Content="Unchecked"/>
            <RadioButton GroupName="one" Content="Checked" IsChecked="True"/>
            <RadioButton Visibility="Hidden"/>

            <TextBlock Text="ComboBox (default header)" Margin="0,5,0,0"/>
            <ComboBox x:Name="ComboBoxByName" DisplayMemberPath="Name">
                <ComboBox.GroupStyle>
                    <GroupStyle/>
                </ComboBox.GroupStyle>
            </ComboBox>

            <TextBlock Text="ComboBox (custom header)"/>
            <ComboBox x:Name="ComboBoxByKind" DisplayMemberPath="Name">
                <ComboBox.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name.DisplayName}"/>
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </ComboBox.GroupStyle>
            </ComboBox>
            <TextBlock Text="ComboBox (default header)"/>
            <ComboBox x:Name="ComboBoxEditable" IsEditable="True" DisplayMemberPath="Name">
                <ComboBox.GroupStyle>
                    <GroupStyle/>
                </ComboBox.GroupStyle>
            </ComboBox>
        </StackPanel>
        <StackPanel Grid.Column="2" Grid.Row="0" Margin="5,0,0,0" wpf:MarginSetter.Margin="5">
            <Button Content="Press me!" MinWidth="200"/>
            <ToggleButton Content="Toggle me!"/>
            
            <ProgressBar Value="73" Height="15"/>
            <ProgressBar IsIndeterminate="True" Height="15"/>
            
            <Slider x:Name="SliderC"
                    Maximum="30"
                    TickFrequency="3"
                    Value="12"
                    TickPlacement="BottomRight"/>
        </StackPanel>
        <StackPanel Grid.Column="0" Grid.Row="1" Grid.ColumnSpan="2">
            <HeaderedContentControl Header="Headered Content Control" Height="150">
                <TextBox AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         MaxLength="1000"/>
            </HeaderedContentControl>
        </StackPanel>
        <StackPanel Grid.Column="2" Grid.Row="1">
            <TreeView Height="150">
                <TreeViewItem Header="Europe" IsExpanded="True">
                    <TreeViewItem Header="Frankfurt DC" IsExpanded="True">
                        <TreeViewItem Header="fra-web-01" />
                        <TreeViewItem Header="fra-sql-01" />
                        <TreeViewItem Header="fra-ca-01" />
                    </TreeViewItem>
                    <TreeViewItem Header="London DC">
                        <TreeViewItem Header="lon-web-01" />
                        <TreeViewItem Header="lon-sql-01" />
                        <TreeViewItem Header="lon-ca-01" />
                    </TreeViewItem>
                    <TreeViewItem Header="Amsterdam DC">
                        <TreeViewItem Header="ams-web-01" />
                        <TreeViewItem Header="ams-sql-01" />
                        <TreeViewItem Header="ams-ca-01" />
                    </TreeViewItem>
                </TreeViewItem>
                <TreeViewItem Header="North America">
                    <TreeViewItem Header="New York DC">
                        <TreeViewItem Header="nyc-web-01" />
                        <TreeViewItem Header="nyc-sql-01" />
                        <TreeViewItem Header="nyc-ca-01" />
                    </TreeViewItem>
                    <TreeViewItem Header="Dallas DC">
                        <TreeViewItem Header="dal-web-01" />
                        <TreeViewItem Header="dal-sql-01" />
                        <TreeViewItem Header="dal-ca-01" />
                    </TreeViewItem>
                    <TreeViewItem Header="Toronto DC">
                        <TreeViewItem Header="tor-web-01" />
                        <TreeViewItem Header="tor-sql-01" />
                        <TreeViewItem Header="tor-ca-01" />
                    </TreeViewItem>
                </TreeViewItem>
                <TreeViewItem Header="Asia Pacific">
                    <TreeViewItem Header="Tokyo DC">
                        <TreeViewItem Header="tyo-web-01" />
                        <TreeViewItem Header="tyo-sql-01" />
                        <TreeViewItem Header="tyo-ca-01" />
                    </TreeViewItem>
                    <TreeViewItem Header="Singapore DC">
                        <TreeViewItem Header="sin-web-01" />
                        <TreeViewItem Header="sin-sql-01" />
                        <TreeViewItem Header="sin-ca-01" />
                    </TreeViewItem>
                    <TreeViewItem Header="Sydney DC">
                        <TreeViewItem Header="syd-web-01" />
                        <TreeViewItem Header="syd-sql-01" />
                        <TreeViewItem Header="syd-ca-01" />
                    </TreeViewItem>
                </TreeViewItem>
            </TreeView>
        </StackPanel>
        <StackPanel Grid.Column="0" Grid.Row="2" Grid.ColumnSpan="2">
            <ListBox x:Name="ListBoxC"
                     Height="150"
                     DisplayMemberPath="Name"/>
        </StackPanel>
        <StackPanel Grid.Column="2" Grid.Row="2">
            <ListView x:Name="ListViewC"
                     Height="150"
                     DisplayMemberPath="Name">
                <ListView.GroupStyle>
                    <GroupStyle/>
                </ListView.GroupStyle>
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Name" DisplayMemberBinding="{Binding Name}"/>
                        <GridViewColumn Header="Value" DisplayMemberBinding="{Binding Group}"/>
                    </GridView>
                </ListView.View>
            </ListView>
        </StackPanel>
    </Grid>
</UserControl>
